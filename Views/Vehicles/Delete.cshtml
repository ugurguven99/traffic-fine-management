@model Traffic.Models.Vehicle

@{
    ViewData["Title"] = "Araç Sil";
}

<h2 class="mb-3">Araç Silme Onayý</h2>

<div class="alert alert-warning">
    <strong>Dikkat!</strong>
    Bu aracý silmek istediðinizden emin misiniz?
    Bu iþlem geri alýnamaz.
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Silinecek Araç Bilgileri</strong>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 mb-3">Plaka</dt>
            <dd class="col-sm-8 mb-3">
                @Model.Plate
            </dd>

            <dt class="col-sm-4 mb-3">Araç Tipi</dt>
            <dd class="col-sm-8 mb-3">
                @Html.DisplayFor(m => m.VehicleType)
            </dd>

            <dt class="col-sm-4 mb-3">Marka</dt>
            <dd class="col-sm-8 mb-3">
                @Model.Brand
            </dd>

            <dt class="col-sm-4">Model</dt>
            <dd class="col-sm-8">
                @Model.Model
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <input type="hidden"
           name="rowVersion"
           value="@Convert.ToBase64String(Model.RowVersion)" />

    <div class="d-flex flex-wrap gap-2">
        <button type="submit"
                class="btn btn-danger">
            Aracý Sil
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Vazgeç
        </a>
    </div>
</form>
