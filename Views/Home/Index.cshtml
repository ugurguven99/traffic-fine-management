@model Traffic.Models.DashboardViewModel

@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="mb-4">
    <h2 class="mb-2">Trafik Ceza Yönetim Paneli</h2>
    <p class="text-muted">
        Araç, ceza ve onay süreçlerinin genel durumunu
        bu ekrandan takip edebilirsiniz.
    </p>
</div>

<!-- İSTATİSTİK KARTLARI -->
<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted mb-2">Toplam Araç</div>
                <h2 class="fw-bold mb-0">
                    @Model.TotalVehicles
                </h2>
                <div class="small text-primary mt-2">
                    Araç kayıtları
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted mb-2">Toplam Trafik Cezası</div>
                <h2 class="fw-bold mb-0">
                    @Model.TotalFines
                </h2>
                <div class="small text-primary mt-2">
                    Sistemdeki bütün cezalar
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted mb-2">Onay Bekleyen</div>
                <h2 class="fw-bold mb-0 text-warning">
                    @Model.PendingApprovalCount
                </h2>
                <div class="small text-muted mt-2">
                    Yönetici + Finans onayı
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted mb-2">Tamamlanan</div>
                <h2 class="fw-bold mb-0 text-success">
                    @Model.CompletedFines
                </h2>
                <div class="small text-muted mt-2">
                    Onay süreci biten cezalar
                </div>
            </div>
        </div>
    </div>

</div>

<!-- DURUM ÖZETİ -->
<div class="row g-3 mb-4">

    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-header">
                <strong>Ceza Durum Özeti</strong>
            </div>

            <div class="card-body">
                <div class="d-flex justify-content-between
                            border-bottom py-2">
                    <span>Yeni</span>
                    <span class="badge bg-primary">
                        @Model.NewFines
                    </span>
                </div>

                <div class="d-flex justify-content-between
                            border-bottom py-2">
                    <span>Yönetici Onayı Bekleyen</span>
                    <span class="badge bg-warning text-dark">
                        @Model.ManagerPendingCount
                    </span>
                </div>

                <div class="d-flex justify-content-between
                            border-bottom py-2">
                    <span>Finans Onayı Bekleyen</span>
                    <span class="badge bg-info text-dark">
                        @Model.FinancePendingCount
                    </span>
                </div>

                <div class="d-flex justify-content-between
                            border-bottom py-2">
                    <span>Tamamlanan</span>
                    <span class="badge bg-success">
                        @Model.CompletedFines
                    </span>
                </div>

                <div class="d-flex justify-content-between py-2">
                    <span>Reddedilen</span>
                    <span class="badge bg-danger">
                        @Model.RejectedFines
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-header">
                <strong>Finansal Özet</strong>
            </div>

            <div class="card-body d-flex flex-column
                        justify-content-center text-center">

                <div class="text-muted mb-2">
                    Toplam Ceza Tutarı
                </div>

                <h2 class="fw-bold text-primary">
                    @Model.TotalFineAmount.ToString("N2") TL
                </h2>

                <p class="small text-muted mb-0">
                    Tüm trafik cezası kayıtlarının
                    toplam tutarıdır.
                </p>
            </div>
        </div>
    </div>

</div>

<!-- HIZLI ERİŞİM -->
<div class="card shadow-sm">
    <div class="card-header">
        <strong>Hızlı Erişim</strong>
    </div>

    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Vehicles"
               asp-action="Index"
               class="btn btn-outline-primary">
                Araç Yönetimi
            </a>

            <a asp-controller="TrafficFines"
               asp-action="Index"
               class="btn btn-outline-primary">
                Trafik Cezaları
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Kullanıcı Yönetimi
                </a>

                <a asp-controller="TrafficFines"
                   asp-action="Create"
                   class="btn btn-primary">
                    + Yeni Trafik Cezası
                </a>
            }

        </div>
    </div>
</div>
