@model Traffic.Models.TrafficFine
@using Traffic.Models
@using Traffic.Helpers
@{
    ViewData["Title"] = "Trafik Cezasý Detayý";

    bool canApprove =
        (Model.Status == FineStatus.ManagerApproval &&
         User.IsInRole("Manager"))
        ||
        (Model.Status == FineStatus.FinanceApproval &&
         User.IsInRole("Finance"));
}

<h2 class="mb-4">Trafik Cezasý Detayý</h2>


<!-- TRAFÝK CEZASI BÝLGÝLERÝ -->
<div class="card mb-4">
    <div class="card-header">
        <strong>Ceza Bilgileri</strong>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-4">Plaka</dt>
            <dd class="col-sm-8">
                @Model.Vehicle.Plate
            </dd>

            <dt class="col-sm-4">Araç</dt>
            <dd class="col-sm-8">
                @Model.Vehicle.Brand @Model.Vehicle.Model
            </dd>

            <dt class="col-sm-4">Ceza Tutarý</dt>
            <dd class="col-sm-8">
                @Model.FineAmount.ToString("N2") TL
            </dd>

            <dt class="col-sm-4">Ceza Tarihi</dt>
            <dd class="col-sm-8">
                @Model.FineDate.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-4">Açýklama</dt>
            <dd class="col-sm-8 text-break">
                @Model.Description
            </dd>

            <dt class="col-sm-4">Durum</dt>
            <dd class="col-sm-8">
                @switch (Model.Status)
                {
                    case FineStatus.New:
                        <span class="badge bg-primary">Yeni</span>
                        break;

                    case FineStatus.ManagerApproval:
                        <span class="badge bg-warning text-dark">
                            Yönetici Onayý
                        </span>
                        break;

                    case FineStatus.FinanceApproval:
                        <span class="badge bg-info text-dark">
                            Finans Onayý
                        </span>
                        break;

                    case FineStatus.Completed:
                        <span class="badge bg-success">
                            Tamamlandý
                        </span>
                        break;

                    case FineStatus.Rejected:
                        <span class="badge bg-danger">
                            Reddedildi
                        </span>
                        break;
                }
            </dd>

            <dt class="col-sm-4">Oluþturulma Tarihi</dt>
            <dd class="col-sm-8">
                @(Model.CreatedAt.ToLocalTime()
                                .ToString("dd.MM.yyyy HH:mm"))
            </dd>

        </dl>
    </div>
</div>

<!-- ONAY ÝÞLEMLERÝ -->
<div class="card mb-4">
    <div class="card-header">
        <strong>Onay Ýþlemleri</strong>
    </div>

    <div class="card-body">

        @if (Model.Status == FineStatus.New &&
                User.IsInRole("Admin"))
        {
            <form asp-controller="TrafficFines"
                  asp-action="Submit"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit"
                        class="btn btn-primary">
                    Onaya Gönder
                </button>
            </form>
        }
        else if (canApprove)
        {
            <form asp-controller="TrafficFines"
                  asp-action="Approve"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="mb-4">

                <button type="submit"
                        class="btn btn-success">
                    Onayla
                </button>
            </form>

            <hr />

            <form asp-controller="TrafficFines"
                  asp-action="Reject"
                  asp-route-id="@Model.Id"
                  method="post">

                <div class="mb-3">
                    <label for="description"
                           class="form-label">
                        Ret Nedeni
                    </label>

                    <textarea id="description"
                          name="description"
                          class="form-control"
                          rows="3"
                          maxlength="500"
                          required
                          placeholder="Ret nedenini yazýnýz..."></textarea>

                    <div class="form-text">
                        Ret nedeni zorunludur.
                        En fazla 500 karakter yazabilirsiniz.
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Reddet
                </button>
            </form>
        }
        else if (Model.Status == FineStatus.Completed)
        {
            <div class="alert alert-success mb-0">
                Bu trafik cezasýnýn onay süreci tamamlanmýþtýr.
            </div>
        }
        else if (Model.Status == FineStatus.Rejected)
        {
            <div class="alert alert-danger mb-0">
                Bu trafik cezasý reddedilmiþtir.
                Ret nedenini onay geçmiþinde görebilirsiniz.
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-0">
                Bu aþamada iþlem yapma yetkiniz bulunmuyor.
            </div>
        }

    </div>
</div>

<!-- ONAY GEÇMÝÞÝ -->
<div class="card mb-4">
    <div class="card-header">
        <strong>Onay Geçmiþi</strong>
    </div>

    <div class="card-body">

        @if (Model.ApprovalHistories == null ||
                !Model.ApprovalHistories.Any())
        {
            <p class="text-muted mb-0">
                Henüz herhangi bir onay veya ret iþlemi
                gerçekleþtirilmemiþ.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Kullanýcý</th>
                            <th>Ýþlem</th>
                            <th>Önceki Durum</th>
                            <th>Yeni Durum</th>
                            <th>Açýklama</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var history in
                                            Model.ApprovalHistories
                                            .OrderBy(h => h.ActionDate)
                                            .ThenBy(h => h.Id))
                        {
                            <tr>
                                <td>
                                    @(history.ActionDate
                                                                .ToLocalTime()
                                                                .ToString("dd.MM.yyyy HH:mm"))
                        </td>

                                <td>@history.UserEmail</td>

                                <td>
                            @switch (history.Action)
                                    {
                                        case ApprovalAction.Submit:
                                            <span class="badge bg-primary">
                                                Onaya Gönderildi
                                            </span>
                                            break;

                                        case ApprovalAction.Approve:
                                            <span class="badge bg-success">
                                                Onaylandý
                                            </span>
                                            break;

                                        case ApprovalAction.Reject:
                                            <span class="badge bg-danger">
                                                Reddedildi
                                            </span>
                                            break;
                                    }
                                </td>


                                <td>@history.PreviousStatus.GetDisplayName()</td>
                                <td>@history.NewStatus.GetDisplayName()</td>


                                <td class="text-break">
                                    @history.Description
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

<!-- SAYFA BUTONLARI -->
<div class="d-flex gap-2 mb-4">


    @if (User.IsInRole("Admin") &&
        Model.Status == FineStatus.New)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Düzenle
        </a>
    }


    <a asp-action="Index"
       class="btn btn-secondary">
        Listeye Dön
    </a>

</div>
